# Copy to infra/.env and fill in. Never commit infra/.env.
DB_PASSWORD=change-me
# 32+ random characters, e.g.: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
# Encrypts 2FA secrets. Keep a copy somewhere safe: losing it invalidates 2FA for everyone.
TOTP_KEY=change-me-to-another-long-random-string
# Public host name for automatic HTTPS, or ":80" for a local plain-HTTP test.
DOMAIN=:80
# Web Push keys: docker compose run --rm api node_modules/.bin/web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:it@your-center.kz
APP_TIMEZONE=Asia/Almaty
# Per-file upload limit, megabytes.
MAX_UPLOAD_MB=25
# Backups: how long to keep encrypted archives, and the folder on the server where they are put.
BACKUP_KEEP_DAYS=30
BACKUP_HOST_DIR=./backups
# The passphrase itself lives in infra/backup.pass (one line, chmod 600, never committed).
# Name of the organisation in the header of generated documents.
ORG_NAME_RU=Центр гематологии
ORG_NAME_KK=Гематология орталығы
# Documents are made in Word only. For PDF as well: PDF_ENABLED=true, GOTENBERG_URL=http://gotenberg:3000, and start with --profile pdf.
PDF_ENABLED=false
GOTENBERG_URL=
# 2FA for administrators and management. Set false ONLY on a test server without real data; then remove the line again.
REQUIRE_ADMIN_TOTP=true
