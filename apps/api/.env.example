DATABASE_URL="postgresql://hemcenter:hemcenter@localhost:5432/hemcenter"
# 32+ random characters: openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string"
# Encrypts 2FA secrets in the database. If unset, JWT_SECRET is used (then rotating it breaks everyone's 2FA).
# TOTP_KEY="another-long-random-string"
WEB_ORIGIN="http://localhost:3000"
# Attachments live here (a persistent volume in production, included in the backup).
FILES_DIR="./data/files"
# Upload limit per file in megabytes (decisions-needed #15).
# MAX_UPLOAD_MB=25
# Time zone for quiet hours.
# APP_TIMEZONE="Asia/Almaty"
# Web Push. Generate once:  npx web-push generate-vapid-keys
# Without these keys push is switched off; the app keeps working. Keep the PRIVATE key secret and backed up:
# if it changes, every device must subscribe again.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT="mailto:it@your-center.kz"
