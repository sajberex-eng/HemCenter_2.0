generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGEMENT
  SECRETARY
  PROJECT_MANAGER
  EMPLOYEE
}

enum ChatType {
  DIRECT
  GROUP
  // Imported history (e.g. from WhatsApp): read-only.
  ARCHIVE
}

enum ChatRole {
  OWNER
  MEMBER
}

enum NotifyMode {
  ALL
  MENTIONS
  NONE
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  DONE
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
}

enum DecisionAnswer {
  AGREE
  OBJECT
  ACKNOWLEDGED
}

enum DocumentStatus {
  DRAFT
  IN_REVIEW
  RETURNED
  APPROVED
  SIGNED
  REGISTERED
}

enum StepStatus {
  PENDING
  APPROVED
  RETURNED
}

enum ApprovalActionKind {
  SUBMIT
  APPROVE
  RETURN
  SCAN
  REGISTER
}

enum MeetingStatus {
  PLANNED
  HELD
  CANCELED
}

enum ResolutionKind {
  DECISION
  INSTRUCTION
}

enum AssignmentStatus {
  NEW
  IN_PROGRESS
  REVIEW
  DONE
  RETURNED
  REMOVED
}

enum AssignmentSource {
  DOCUMENT
  CHAT
  MANUAL
}

enum ReportStatus {
  PENDING
  ACCEPTED
  RETURNED
}

enum DueChangeStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AssignmentEventKind {
  CREATED
  STARTED
  REPORT
  ACCEPTED
  RETURNED
  DUE_REQUESTED
  DUE_APPROVED
  DUE_REJECTED
  REMOVED
}

enum Locale {
  ru
  kk
}

model Department {
  id        String       @id @default(uuid())
  nameRu    String
  nameKk    String
  parentId  String?
  parent    Department?  @relation("DepartmentTree", fields: [parentId], references: [id])
  children  Department[] @relation("DepartmentTree")
  users     User[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model Position {
  id        String   @id @default(uuid())
  nameRu    String
  nameKk    String
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id                    String              @id @default(uuid())
  login                 String              @unique
  passwordHash          String
  mustChangePassword    Boolean             @default(true)
  fullName              String
  phone                 String?
  email                 String?
  roles                 Role[]
  locale                Locale              @default(ru)
  departmentId          String?
  department            Department?         @relation(fields: [departmentId], references: [id])
  positionId            String?
  position              Position?           @relation(fields: [positionId], references: [id])
  isActive              Boolean             @default(true)
  failedLogins          Int                 @default(0)
  lockedUntil           DateTime?
  tokenVersion          Int                 @default(0)
  consentAt             DateTime?
  // Two-factor authentication (TOTP). The secret is stored encrypted (AES-256-GCM).
  totpSecretEnc         String?
  totpEnabled           Boolean             @default(false)
  totpLastStep          Int?
  totpRecoveryHashes    String[]
  // Notification preferences (TZ 3.8): manual do-not-disturb and daily quiet hours (local HH:mm).
  // A name from an imported chat that has no account here: it cannot sign in and is never listed in the directory.
  isExternal            Boolean             @default(false)
  dndUntil              DateTime?
  quietStart            String?
  quietEnd              String?
  pushSubscriptions     PushSubscription[]
  lastLoginAt           DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  sessions              Session[]
  invitations           Invitation[]
  chatMemberships       ChatMember[]
  messages              Message[]
  chatsCreated          Chat[]
  attachments           Attachment[]
  pinsMade              Pin[]
  projectMemberships    ProjectMember[]
  tasksAssigned         Task[]              @relation("TaskAssignee")
  tasksCreated          Task[]              @relation("TaskCreator")
  decisionsCreated      Decision[]
  decisionAnswers       DecisionResponse[]
  projectsLed           Project[]           @relation("ProjectManager")
  projectsCurated       Project[]           @relation("ProjectCurator")
  documents             Document[]          @relation("DocumentAuthor")
  templatesUploaded     DocumentTemplate[]
  approvalSteps         ApprovalStep[]
  approvalActions       ApprovalAction[]
  meetingsCreated       Meeting[]           @relation("MeetingCreator")
  meetingsChaired       Meeting[]           @relation("MeetingChair")
  meetingsKept          Meeting[]           @relation("MeetingSecretary")
  resolutions           MeetingResolution[]
  assignmentsOwned      Assignment[]        @relation("AssignmentResponsible")
  assignmentsControlled Assignment[]        @relation("AssignmentController")
  assignmentsCreated    Assignment[]        @relation("AssignmentCreator")
  reports               ExecutionReport[]   @relation("ReportAuthor")
  reportsReviewed       ExecutionReport[]   @relation("ReportReviewer")
  dueRequests           DueChange[]         @relation("DueRequester")
  dueDecisions          DueChange[]         @relation("DueDecider")
  assignmentEvents      AssignmentEvent[]
  notifications         Notification[]
}

model Session {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  revokedAt DateTime?
  // Set only when the token was replaced by a newer one (rotation); a logout or a revocation never sets it.
  rotatedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Invitation {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// Append-only: UPDATE and DELETE are blocked by a database trigger (see migration).
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  at         DateTime @default(now())
  actorId    String?
  action     String
  entityType String?
  entityId   String?
  data       Json?
  ip         String?

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([at])
}

model Chat {
  id            String       @id @default(uuid())
  type          ChatType
  title         String?
  // "<smaller user id>:<larger user id>" - guarantees a single direct chat per pair of people.
  directKey     String?      @unique
  createdById   String
  createdBy     User         @relation(fields: [createdById], references: [id])
  // Highest message number used in this chat. Incremented inside the same transaction that inserts the message.
  lastSeq       Int          @default(0)
  lastMessageAt DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  // Set for imported history: hash of the source file, so the same export cannot be imported twice.
  importHash    String?      @unique
  importedAt    DateTime?
  importedById  String?
  members       ChatMember[]
  messages      Message[]
  attachments   Attachment[]
  pins          Pin[]
  project       Project?
  meeting       Meeting?
  decisions     Decision[]
  tasks         Task[]
}

model ChatMember {
  chatId      String
  chat        Chat       @relation(fields: [chatId], references: [id], onDelete: Cascade)
  userId      String
  user        User       @relation(fields: [userId], references: [id])
  role        ChatRole   @default(MEMBER)
  notifyMode  NotifyMode @default(ALL)
  // Everything with seq <= lastReadSeq is read by this member (drives unread counters and read receipts).
  lastReadSeq Int        @default(0)
  joinedAt    DateTime   @default(now())

  @@id([chatId, userId])
  @@index([userId])
}

model Message {
  id          String       @id @default(uuid())
  chatId      String
  chat        Chat         @relation(fields: [chatId], references: [id], onDelete: Cascade)
  seq         Int
  authorId    String
  author      User         @relation(fields: [authorId], references: [id])
  // null after deletion; the original text is kept in the audit log.
  body        String?
  replyToId   String?
  replyTo     Message?     @relation("Replies", fields: [replyToId], references: [id])
  replies     Message[]    @relation("Replies")
  attachments Attachment[]
  pins        Pin[]
  mentionIds  String[]
  tasks       Task[]
  decision    Decision?
  createdAt   DateTime     @default(now())
  editedAt    DateTime?
  deletedAt   DateTime?

  @@unique([chatId, seq])
  @@index([authorId])
}

// A file uploaded into a chat. It exists before the message that carries it (upload first, then send),
// and is removed from disk when that message is deleted or when it is never sent.
model Attachment {
  id         String    @id @default(uuid())
  chatId     String
  chat       Chat      @relation(fields: [chatId], references: [id], onDelete: Cascade)
  uploaderId String
  uploader   User      @relation(fields: [uploaderId], references: [id])
  messageId  String?
  message    Message?  @relation(fields: [messageId], references: [id], onDelete: SetNull)
  // Display name only. The place on disk is storageKey, generated by the server.
  name       String
  // image/png|jpeg|gif|webp when the content really is one of those, otherwise application/octet-stream.
  mime       String
  size       Int
  sha256     String
  storageKey String    @unique
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?

  @@index([messageId])
  @@index([chatId])
  @@index([uploaderId])
}

// One browser/device that agreed to receive push notifications.
model PushSubscription {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Address of the browser vendor's push service; validated against an allow-list before it is stored or used.
  endpoint      String    @unique
  p256dh        String
  auth          String
  userAgent     String?
  failures      Int       @default(0)
  createdAt     DateTime  @default(now())
  lastSuccessAt DateTime?

  @@index([userId])
}

// A message pinned to the top of a chat.
model Pin {
  chatId     String
  chat       Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  messageId  String
  message    Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  pinnedById String
  pinnedBy   User     @relation(fields: [pinnedById], references: [id])
  pinnedAt   DateTime @default(now())

  @@id([chatId, messageId])
  @@index([chatId, pinnedAt])
}

// A WhatsApp export that was uploaded for preview and is waiting to be imported (or discarded after a day).
model ImportSession {
  id           String   @id @default(uuid())
  createdById  String
  // temporary file under FILES_DIR/imports, removed after the import or when the session expires
  filePath     String
  originalName String
  sha256       String
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@index([createdById])
  @@index([expiresAt])
}

// ---- Project office (stage 3) ------------------------------------------------------------------------------------

model Project {
  id         String          @id @default(uuid())
  name       String
  goal       String?
  status     ProjectStatus   @default(PLANNED)
  startDate  DateTime?       @db.Date
  endDate    DateTime?       @db.Date
  managerId  String
  manager    User            @relation("ProjectManager", fields: [managerId], references: [id])
  curatorId  String?
  curator    User?           @relation("ProjectCurator", fields: [curatorId], references: [id])
  // The project's own group chat; its members follow the team.
  chatId     String          @unique
  chat       Chat            @relation(fields: [chatId], references: [id])
  members    ProjectMember[]
  milestones Milestone[]
  tasks      Task[]
  decisions  Decision[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  meetings   Meeting[]
}

model ProjectMember {
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  // Share of the person's working time in this project, 0-100. Totals above 100 across active projects are flagged.
  allocation Int      @default(0)
  roleTitle  String?
  joinedAt   DateTime @default(now())

  @@id([projectId, userId])
  @@index([userId])
}

model Milestone {
  id        String    @id @default(uuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  dueDate   DateTime  @db.Date
  // Overdue is derived: not done and dueDate in the past.
  doneAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([projectId])
}

model Task {
  id              String     @id @default(uuid())
  projectId       String?
  project         Project?   @relation(fields: [projectId], references: [id])
  title           String
  description     String?
  // Exactly one responsible person - required by design (TZ 3.2).
  assigneeId      String
  assignee        User       @relation("TaskAssignee", fields: [assigneeId], references: [id])
  coAssigneeIds   String[]
  dueDate         DateTime?  @db.Date
  status          TaskStatus @default(OPEN)
  doneAt          DateTime?
  createdById     String
  createdBy       User       @relation("TaskCreator", fields: [createdById], references: [id])
  // The message the task was born from. The link stays if the message is later deleted.
  sourceChatId    String?
  sourceChat      Chat?      @relation(fields: [sourceChatId], references: [id])
  sourceMessageId String?
  sourceMessage   Message?   @relation(fields: [sourceMessageId], references: [id])
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([assigneeId, status])
  @@index([projectId])
}

model Decision {
  id              String              @id @default(uuid())
  projectId       String?
  project         Project?            @relation(fields: [projectId], references: [id])
  text            String
  addresseeIds    String[]
  createdById     String
  createdBy       User                @relation(fields: [createdById], references: [id])
  sourceChatId    String
  sourceChat      Chat                @relation(fields: [sourceChatId], references: [id])
  // One decision per message.
  sourceMessageId String?             @unique
  sourceMessage   Message?            @relation(fields: [sourceMessageId], references: [id])
  resolutions     MeetingResolution[]
  responses       DecisionResponse[]
  createdAt       DateTime            @default(now())

  @@index([sourceChatId])
}

model DecisionResponse {
  decisionId String
  decision   Decision       @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  userId     String
  user       User           @relation(fields: [userId], references: [id])
  answer     DecisionAnswer
  // Required for OBJECT.
  comment    String?
  at         DateTime       @default(now())

  @@id([decisionId, userId])
}

// ---- Documents (stage 4) -----------------------------------------------------------------------------------------

// A kind of document the centre issues (protocol, order, memo...). Maintained by the secretary.
model DocumentKind {
  id        String             @id @default(uuid())
  // Stable machine name for the built-in kinds (PROTOCOL, ORDER, MEMO, DIRECTIVE); null for ones the secretary adds.
  code      String?            @unique
  nameRu    String
  nameKk    String
  // Letters in the registration number, e.g. "ПР" gives "12-ПР/2026".
  prefix    String
  isActive  Boolean            @default(true)
  createdAt DateTime           @default(now())
  templates DocumentTemplate[]
  documents Document[]
  counters  RegistryCounter[]
}

// The last number given in a journal in a year. Locked while a number is handed out, so numbers never repeat.
model RegistryCounter {
  kindId String
  kind   DocumentKind @relation(fields: [kindId], references: [id])
  year   Int
  last   Int          @default(0)

  @@id([kindId, year])
}

// A Word file with {fields}. A new upload is a new version; the highest active version of a kind and language is used.
model DocumentTemplate {
  id           String       @id @default(uuid())
  kindId       String
  kind         DocumentKind @relation(fields: [kindId], references: [id])
  lang         Locale
  version      Int
  name         String
  fileKey      String
  sha256       String
  isActive     Boolean      @default(true)
  uploadedById String?
  uploadedBy   User?        @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime     @default(now())
  documents    Document[]

  @@unique([kindId, lang, version])
}

model Document {
  id                 String            @id @default(uuid())
  kindId             String
  kind               DocumentKind      @relation(fields: [kindId], references: [id])
  templateId         String?
  template           DocumentTemplate? @relation(fields: [templateId], references: [id])
  title              String
  lang               Locale
  // What goes into the template fields (preamble, items, participants...). Validated in the service.
  data               Json
  status             DocumentStatus    @default(DRAFT)
  docDate            DateTime          @db.Date
  authorId           String
  author             User              @relation("DocumentAuthor", fields: [authorId], references: [id])
  registrationNumber String?
  registeredAt       DateTime?
  // Generated files. Cleared whenever the content changes; a registered document keeps its PDF and the PDF's hash.
  docxKey            String?
  pdfKey             String?
  pdfSha256          String?
  // SHA-256 of the final Word file, fixed when the document is registered (the anchor for a later signature).
  docxSha256         String?
  renderedAt         DateTime?
  // How many times it was sent for approval; steps are reset on each round and the history stays in ApprovalAction.
  round              Int               @default(0)
  // The signed paper copy, scanned.
  scanKey            String?
  scanName           String?
  scanMime           String?
  scanSize           Int?
  scanSha256         String?
  scanAt             DateTime?
  registeredById     String?
  steps              ApprovalStep[]
  actions            ApprovalAction[]
  meeting            Meeting?
  assignments        Assignment[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  // A number is never given twice within a kind; documents without a number do not clash (NULLs are distinct).
  @@unique([kindId, registrationNumber])
  @@index([authorId])
  @@index([status])
}

// One approver in the route. Steps with the same stage are approved in parallel; stages go one after another.
model ApprovalStep {
  id         String     @id @default(uuid())
  documentId String
  document   Document   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  approverId String
  approver   User       @relation(fields: [approverId], references: [id])
  stage      Int
  status     StepStatus @default(PENDING)
  decidedAt  DateTime?
  comment    String?

  @@unique([documentId, approverId])
  @@index([approverId, status])
}

// The approval sheet: everything that happened, in order. Never edited.
model ApprovalAction {
  id         String             @id @default(uuid())
  documentId String
  document   Document           @relation(fields: [documentId], references: [id], onDelete: Cascade)
  round      Int
  actorId    String
  actor      User               @relation(fields: [actorId], references: [id])
  kind       ApprovalActionKind
  comment    String?
  at         DateTime           @default(now())

  @@index([documentId, at])
}

// ---- Meetings and protocols (stage 4) ----------------------------------------------------------------------------

model Meeting {
  id          String        @id @default(uuid())
  subject     String
  startsAt    DateTime
  place       String?
  projectId   String?
  project     Project?      @relation(fields: [projectId], references: [id])
  // The meeting's own chat; its members are the participants.
  chatId      String        @unique
  chat        Chat          @relation(fields: [chatId], references: [id])
  chairId     String
  chair       User          @relation("MeetingChair", fields: [chairId], references: [id])
  secretaryId String
  secretary   User          @relation("MeetingSecretary", fields: [secretaryId], references: [id])
  createdById String
  createdBy   User          @relation("MeetingCreator", fields: [createdById], references: [id])
  status      MeetingStatus @default(PLANNED)
  // The protocol made from this meeting (a Document of the protocol kind).
  protocolId  String?       @unique
  protocol    Document?     @relation(fields: [protocolId], references: [id])
  items       MeetingItem[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([startsAt])
}

// One point of the agenda, with what was heard under it.
model MeetingItem {
  id          String              @id @default(uuid())
  meetingId   String
  meeting     Meeting             @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  position    Int
  title       String
  heard       String?
  resolutions MeetingResolution[]

  @@index([meetingId, position])
}

// A decision taken or an instruction given under an agenda point. An instruction has a responsible person and a due date.
model MeetingResolution {
  id            String         @id @default(uuid())
  itemId        String
  item          MeetingItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  position      Int
  kind          ResolutionKind
  text          String
  responsibleId String?
  responsible   User?          @relation(fields: [responsibleId], references: [id])
  due           DateTime?      @db.Date
  // Set when the text was taken over from a decision confirmed in the meeting chat.
  decisionId    String?
  decision      Decision?      @relation(fields: [decisionId], references: [id])

  @@index([itemId, position])
}

// ---- Execution control (stage 4d) --------------------------------------------------------------------------------

// A formal instruction with one responsible person, a controller and a due date.
model Assignment {
  id                 String            @id @default(uuid())
  text               String
  responsibleId      String
  responsible        User              @relation("AssignmentResponsible", fields: [responsibleId], references: [id])
  coResponsibleIds   String[]
  controllerId       String
  controller         User              @relation("AssignmentController", fields: [controllerId], references: [id])
  dueDate            DateTime          @db.Date
  // The date first given; the current one may have been moved with the controller's consent.
  originalDue        DateTime          @db.Date
  // "Overdue" is not stored: it is an open assignment whose due date has passed.
  status             AssignmentStatus  @default(NEW)
  doneAt             DateTime?
  removedReason      String?
  sourceKind         AssignmentSource
  sourceDocumentId   String?
  sourceDocument     Document?         @relation(fields: [sourceDocumentId], references: [id])
  // The meeting resolution it came from, so registering a protocol twice cannot create it twice.
  sourceResolutionId String?
  sourceChatId       String?
  sourceMessageId    String?
  createdById        String
  createdBy          User              @relation("AssignmentCreator", fields: [createdById], references: [id])
  reports            ExecutionReport[]
  dueChanges         DueChange[]
  events             AssignmentEvent[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([sourceDocumentId, sourceResolutionId])
  @@index([responsibleId, status])
  @@index([controllerId, status])
  @@index([dueDate])
}

model ExecutionReport {
  id            String       @id @default(uuid())
  assignmentId  String
  assignment    Assignment   @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  authorId      String
  author        User         @relation("ReportAuthor", fields: [authorId], references: [id])
  text          String
  status        ReportStatus @default(PENDING)
  reviewerId    String?
  reviewer      User?        @relation("ReportReviewer", fields: [reviewerId], references: [id])
  reviewComment String?
  reviewedAt    DateTime?
  files         ReportFile[]
  createdAt     DateTime     @default(now())

  @@index([assignmentId, createdAt])
}

model ReportFile {
  id         String          @id @default(uuid())
  reportId   String
  report     ExecutionReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  name       String
  mime       String
  size       Int
  sha256     String
  storageKey String
  createdAt  DateTime        @default(now())
}

// A request to move the due date: needs the controller's consent. The history stays.
model DueChange {
  id            String          @id @default(uuid())
  assignmentId  String
  assignment    Assignment      @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  requestedById String
  requestedBy   User            @relation("DueRequester", fields: [requestedById], references: [id])
  oldDue        DateTime        @db.Date
  newDue        DateTime        @db.Date
  reason        String
  status        DueChangeStatus @default(PENDING)
  decidedById   String?
  decidedBy     User?           @relation("DueDecider", fields: [decidedById], references: [id])
  decisionNote  String?
  decidedAt     DateTime?
  createdAt     DateTime        @default(now())

  @@index([assignmentId, status])
}

// What happened to an assignment, in order. Never edited.
model AssignmentEvent {
  id           String              @id @default(uuid())
  assignmentId String
  assignment   Assignment          @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  actorId      String
  actor        User                @relation(fields: [actorId], references: [id])
  kind         AssignmentEventKind
  comment      String?
  at           DateTime            @default(now())

  @@index([assignmentId, at])
}

// One reminder of a kind per assignment per day, however often the job runs.
model ReminderLog {
  assignmentId String
  kind         String
  day          DateTime @db.Date

  @@id([assignmentId, kind, day])
}

// A line in the person's notification list. Carries no text of the work itself, only what happened and where.
model Notification {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String
  assignmentId String?
  readAt       DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId, readAt])
}
