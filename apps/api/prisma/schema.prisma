generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGEMENT
  SECRETARY
  PROJECT_MANAGER
  EMPLOYEE
}

enum ChatType {
  DIRECT
  GROUP
  // Imported history (e.g. from WhatsApp): read-only.
  ARCHIVE
}

enum ChatRole {
  OWNER
  MEMBER
}

enum NotifyMode {
  ALL
  MENTIONS
  NONE
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  DONE
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
}

enum DecisionAnswer {
  AGREE
  OBJECT
  ACKNOWLEDGED
}

enum DocumentStatus {
  DRAFT
  IN_REVIEW
  RETURNED
  APPROVED
  SIGNED
  REGISTERED
}

enum Locale {
  ru
  kk
}

model Department {
  id        String       @id @default(uuid())
  nameRu    String
  nameKk    String
  parentId  String?
  parent    Department?  @relation("DepartmentTree", fields: [parentId], references: [id])
  children  Department[] @relation("DepartmentTree")
  users     User[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model Position {
  id        String   @id @default(uuid())
  nameRu    String
  nameKk    String
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id                 String             @id @default(uuid())
  login              String             @unique
  passwordHash       String
  mustChangePassword Boolean            @default(true)
  fullName           String
  phone              String?
  email              String?
  roles              Role[]
  locale             Locale             @default(ru)
  departmentId       String?
  department         Department?        @relation(fields: [departmentId], references: [id])
  positionId         String?
  position           Position?          @relation(fields: [positionId], references: [id])
  isActive           Boolean            @default(true)
  failedLogins       Int                @default(0)
  lockedUntil        DateTime?
  tokenVersion       Int                @default(0)
  consentAt          DateTime?
  // Two-factor authentication (TOTP). The secret is stored encrypted (AES-256-GCM).
  totpSecretEnc      String?
  totpEnabled        Boolean            @default(false)
  totpLastStep       Int?
  totpRecoveryHashes String[]
  // Notification preferences (TZ 3.8): manual do-not-disturb and daily quiet hours (local HH:mm).
  // A name from an imported chat that has no account here: it cannot sign in and is never listed in the directory.
  isExternal         Boolean            @default(false)
  dndUntil           DateTime?
  quietStart         String?
  quietEnd           String?
  pushSubscriptions  PushSubscription[]
  lastLoginAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  sessions           Session[]
  invitations        Invitation[]
  chatMemberships    ChatMember[]
  messages           Message[]
  chatsCreated       Chat[]
  attachments        Attachment[]
  pinsMade           Pin[]
  projectMemberships ProjectMember[]
  tasksAssigned      Task[]             @relation("TaskAssignee")
  tasksCreated       Task[]             @relation("TaskCreator")
  decisionsCreated   Decision[]
  decisionAnswers    DecisionResponse[]
  projectsLed        Project[]          @relation("ProjectManager")
  projectsCurated    Project[]          @relation("ProjectCurator")
  documents          Document[]         @relation("DocumentAuthor")
  templatesUploaded  DocumentTemplate[]
}

model Session {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Invitation {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// Append-only: UPDATE and DELETE are blocked by a database trigger (see migration).
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  at         DateTime @default(now())
  actorId    String?
  action     String
  entityType String?
  entityId   String?
  data       Json?
  ip         String?

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([at])
}

model Chat {
  id            String       @id @default(uuid())
  type          ChatType
  title         String?
  // "<smaller user id>:<larger user id>" - guarantees a single direct chat per pair of people.
  directKey     String?      @unique
  createdById   String
  createdBy     User         @relation(fields: [createdById], references: [id])
  // Highest message number used in this chat. Incremented inside the same transaction that inserts the message.
  lastSeq       Int          @default(0)
  lastMessageAt DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  // Set for imported history: hash of the source file, so the same export cannot be imported twice.
  importHash    String?      @unique
  importedAt    DateTime?
  importedById  String?
  members       ChatMember[]
  messages      Message[]
  attachments   Attachment[]
  pins          Pin[]
  project       Project?
  decisions     Decision[]
  tasks         Task[]
}

model ChatMember {
  chatId      String
  chat        Chat       @relation(fields: [chatId], references: [id], onDelete: Cascade)
  userId      String
  user        User       @relation(fields: [userId], references: [id])
  role        ChatRole   @default(MEMBER)
  notifyMode  NotifyMode @default(ALL)
  // Everything with seq <= lastReadSeq is read by this member (drives unread counters and read receipts).
  lastReadSeq Int        @default(0)
  joinedAt    DateTime   @default(now())

  @@id([chatId, userId])
  @@index([userId])
}

model Message {
  id          String       @id @default(uuid())
  chatId      String
  chat        Chat         @relation(fields: [chatId], references: [id], onDelete: Cascade)
  seq         Int
  authorId    String
  author      User         @relation(fields: [authorId], references: [id])
  // null after deletion; the original text is kept in the audit log.
  body        String?
  replyToId   String?
  replyTo     Message?     @relation("Replies", fields: [replyToId], references: [id])
  replies     Message[]    @relation("Replies")
  attachments Attachment[]
  pins        Pin[]
  mentionIds  String[]
  tasks       Task[]
  decision    Decision?
  createdAt   DateTime     @default(now())
  editedAt    DateTime?
  deletedAt   DateTime?

  @@unique([chatId, seq])
  @@index([authorId])
}

// A file uploaded into a chat. It exists before the message that carries it (upload first, then send),
// and is removed from disk when that message is deleted or when it is never sent.
model Attachment {
  id         String    @id @default(uuid())
  chatId     String
  chat       Chat      @relation(fields: [chatId], references: [id], onDelete: Cascade)
  uploaderId String
  uploader   User      @relation(fields: [uploaderId], references: [id])
  messageId  String?
  message    Message?  @relation(fields: [messageId], references: [id], onDelete: SetNull)
  // Display name only. The place on disk is storageKey, generated by the server.
  name       String
  // image/png|jpeg|gif|webp when the content really is one of those, otherwise application/octet-stream.
  mime       String
  size       Int
  sha256     String
  storageKey String    @unique
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?

  @@index([messageId])
  @@index([chatId])
  @@index([uploaderId])
}

// One browser/device that agreed to receive push notifications.
model PushSubscription {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Address of the browser vendor's push service; validated against an allow-list before it is stored or used.
  endpoint      String    @unique
  p256dh        String
  auth          String
  userAgent     String?
  failures      Int       @default(0)
  createdAt     DateTime  @default(now())
  lastSuccessAt DateTime?

  @@index([userId])
}

// A message pinned to the top of a chat.
model Pin {
  chatId     String
  chat       Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  messageId  String
  message    Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  pinnedById String
  pinnedBy   User     @relation(fields: [pinnedById], references: [id])
  pinnedAt   DateTime @default(now())

  @@id([chatId, messageId])
  @@index([chatId, pinnedAt])
}

// A WhatsApp export that was uploaded for preview and is waiting to be imported (or discarded after a day).
model ImportSession {
  id           String   @id @default(uuid())
  createdById  String
  // temporary file under FILES_DIR/imports, removed after the import or when the session expires
  filePath     String
  originalName String
  sha256       String
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@index([createdById])
  @@index([expiresAt])
}

// ---- Project office (stage 3) ------------------------------------------------------------------------------------

model Project {
  id         String          @id @default(uuid())
  name       String
  goal       String?
  status     ProjectStatus   @default(PLANNED)
  startDate  DateTime?       @db.Date
  endDate    DateTime?       @db.Date
  managerId  String
  manager    User            @relation("ProjectManager", fields: [managerId], references: [id])
  curatorId  String?
  curator    User?           @relation("ProjectCurator", fields: [curatorId], references: [id])
  // The project's own group chat; its members follow the team.
  chatId     String          @unique
  chat       Chat            @relation(fields: [chatId], references: [id])
  members    ProjectMember[]
  milestones Milestone[]
  tasks      Task[]
  decisions  Decision[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

model ProjectMember {
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  // Share of the person's working time in this project, 0-100. Totals above 100 across active projects are flagged.
  allocation Int      @default(0)
  roleTitle  String?
  joinedAt   DateTime @default(now())

  @@id([projectId, userId])
  @@index([userId])
}

model Milestone {
  id        String    @id @default(uuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  dueDate   DateTime  @db.Date
  // Overdue is derived: not done and dueDate in the past.
  doneAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([projectId])
}

model Task {
  id              String     @id @default(uuid())
  projectId       String?
  project         Project?   @relation(fields: [projectId], references: [id])
  title           String
  description     String?
  // Exactly one responsible person - required by design (TZ 3.2).
  assigneeId      String
  assignee        User       @relation("TaskAssignee", fields: [assigneeId], references: [id])
  coAssigneeIds   String[]
  dueDate         DateTime?  @db.Date
  status          TaskStatus @default(OPEN)
  doneAt          DateTime?
  createdById     String
  createdBy       User       @relation("TaskCreator", fields: [createdById], references: [id])
  // The message the task was born from. The link stays if the message is later deleted.
  sourceChatId    String?
  sourceChat      Chat?      @relation(fields: [sourceChatId], references: [id])
  sourceMessageId String?
  sourceMessage   Message?   @relation(fields: [sourceMessageId], references: [id])
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([assigneeId, status])
  @@index([projectId])
}

model Decision {
  id              String             @id @default(uuid())
  projectId       String?
  project         Project?           @relation(fields: [projectId], references: [id])
  text            String
  addresseeIds    String[]
  createdById     String
  createdBy       User               @relation(fields: [createdById], references: [id])
  sourceChatId    String
  sourceChat      Chat               @relation(fields: [sourceChatId], references: [id])
  // One decision per message.
  sourceMessageId String?            @unique
  sourceMessage   Message?           @relation(fields: [sourceMessageId], references: [id])
  responses       DecisionResponse[]
  createdAt       DateTime           @default(now())

  @@index([sourceChatId])
}

model DecisionResponse {
  decisionId String
  decision   Decision       @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  userId     String
  user       User           @relation(fields: [userId], references: [id])
  answer     DecisionAnswer
  // Required for OBJECT.
  comment    String?
  at         DateTime       @default(now())

  @@id([decisionId, userId])
}

// ---- Documents (stage 4) -----------------------------------------------------------------------------------------

// A kind of document the centre issues (protocol, order, memo...). Maintained by the secretary.
model DocumentKind {
  id        String             @id @default(uuid())
  // Stable machine name for the built-in kinds (PROTOCOL, ORDER, MEMO, DIRECTIVE); null for ones the secretary adds.
  code      String?            @unique
  nameRu    String
  nameKk    String
  // Letters in the registration number, e.g. "ПР" gives "12-ПР/2026".
  prefix    String
  isActive  Boolean            @default(true)
  createdAt DateTime           @default(now())
  templates DocumentTemplate[]
  documents Document[]
  counters  RegistryCounter[]
}

// The last number given in a journal in a year. Locked while a number is handed out, so numbers never repeat.
model RegistryCounter {
  kindId String
  kind   DocumentKind @relation(fields: [kindId], references: [id])
  year   Int
  last   Int          @default(0)

  @@id([kindId, year])
}

// A Word file with {fields}. A new upload is a new version; the highest active version of a kind and language is used.
model DocumentTemplate {
  id           String       @id @default(uuid())
  kindId       String
  kind         DocumentKind @relation(fields: [kindId], references: [id])
  lang         Locale
  version      Int
  name         String
  fileKey      String
  sha256       String
  isActive     Boolean      @default(true)
  uploadedById String?
  uploadedBy   User?        @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime     @default(now())
  documents    Document[]

  @@unique([kindId, lang, version])
}

model Document {
  id                 String            @id @default(uuid())
  kindId             String
  kind               DocumentKind      @relation(fields: [kindId], references: [id])
  templateId         String?
  template           DocumentTemplate? @relation(fields: [templateId], references: [id])
  title              String
  lang               Locale
  // What goes into the template fields (preamble, items, participants...). Validated in the service.
  data               Json
  status             DocumentStatus    @default(DRAFT)
  docDate            DateTime          @db.Date
  authorId           String
  author             User              @relation("DocumentAuthor", fields: [authorId], references: [id])
  registrationNumber String?
  registeredAt       DateTime?
  // Generated files. Cleared whenever the content changes; a registered document keeps its PDF and the PDF's hash.
  docxKey            String?
  pdfKey             String?
  pdfSha256          String?
  renderedAt         DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([authorId])
  @@index([status])
}
