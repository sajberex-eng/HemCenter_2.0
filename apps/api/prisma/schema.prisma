generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGEMENT
  SECRETARY
  PROJECT_MANAGER
  EMPLOYEE
}

enum ChatType {
  DIRECT
  GROUP
}

enum ChatRole {
  OWNER
  MEMBER
}

enum NotifyMode {
  ALL
  MENTIONS
  NONE
}

enum Locale {
  ru
  kk
}

model Department {
  id        String       @id @default(uuid())
  nameRu    String
  nameKk    String
  parentId  String?
  parent    Department?  @relation("DepartmentTree", fields: [parentId], references: [id])
  children  Department[] @relation("DepartmentTree")
  users     User[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model Position {
  id        String   @id @default(uuid())
  nameRu    String
  nameKk    String
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id                 String       @id @default(uuid())
  login              String       @unique
  passwordHash       String
  mustChangePassword Boolean      @default(true)
  fullName           String
  phone              String?
  email              String?
  roles              Role[]
  locale             Locale       @default(ru)
  departmentId       String?
  department         Department?  @relation(fields: [departmentId], references: [id])
  positionId         String?
  position           Position?    @relation(fields: [positionId], references: [id])
  isActive           Boolean      @default(true)
  failedLogins       Int          @default(0)
  lockedUntil        DateTime?
  tokenVersion       Int          @default(0)
  consentAt          DateTime?
  // Two-factor authentication (TOTP). The secret is stored encrypted (AES-256-GCM).
  totpSecretEnc      String?
  totpEnabled        Boolean      @default(false)
  totpLastStep       Int?
  totpRecoveryHashes String[]
  // Notification preferences (TZ 3.8): manual do-not-disturb and daily quiet hours (local HH:mm).
  dndUntil         DateTime?
  quietStart       String?
  quietEnd         String?
  pushSubscriptions PushSubscription[]
  lastLoginAt        DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  sessions           Session[]
  invitations        Invitation[]
  chatMemberships    ChatMember[]
  messages           Message[]
  chatsCreated       Chat[]
  attachments        Attachment[]
}

model Session {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Invitation {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// Append-only: UPDATE and DELETE are blocked by a database trigger (see migration).
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  at         DateTime @default(now())
  actorId    String?
  action     String
  entityType String?
  entityId   String?
  data       Json?
  ip         String?

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([at])
}

model Chat {
  id            String       @id @default(uuid())
  type          ChatType
  title         String?
  // "<smaller user id>:<larger user id>" - guarantees a single direct chat per pair of people.
  directKey     String?      @unique
  createdById   String
  createdBy     User         @relation(fields: [createdById], references: [id])
  // Highest message number used in this chat. Incremented inside the same transaction that inserts the message.
  lastSeq       Int          @default(0)
  lastMessageAt DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  members       ChatMember[]
  messages      Message[]
  attachments   Attachment[]
}

model ChatMember {
  chatId      String
  chat        Chat       @relation(fields: [chatId], references: [id], onDelete: Cascade)
  userId      String
  user        User       @relation(fields: [userId], references: [id])
  role        ChatRole   @default(MEMBER)
  notifyMode  NotifyMode @default(ALL)
  // Everything with seq <= lastReadSeq is read by this member (drives unread counters and read receipts).
  lastReadSeq Int        @default(0)
  joinedAt    DateTime   @default(now())

  @@id([chatId, userId])
  @@index([userId])
}

model Message {
  id          String       @id @default(uuid())
  chatId      String
  chat        Chat         @relation(fields: [chatId], references: [id], onDelete: Cascade)
  seq         Int
  authorId    String
  author      User         @relation(fields: [authorId], references: [id])
  // null after deletion; the original text is kept in the audit log.
  body        String?
  replyToId   String?
  replyTo     Message?     @relation("Replies", fields: [replyToId], references: [id])
  replies     Message[]    @relation("Replies")
  attachments Attachment[]
  mentionIds  String[]
  createdAt   DateTime     @default(now())
  editedAt    DateTime?
  deletedAt   DateTime?

  @@unique([chatId, seq])
  @@index([authorId])
}

// A file uploaded into a chat. It exists before the message that carries it (upload first, then send),
// and is removed from disk when that message is deleted or when it is never sent.
model Attachment {
  id         String    @id @default(uuid())
  chatId     String
  chat       Chat      @relation(fields: [chatId], references: [id], onDelete: Cascade)
  uploaderId String
  uploader   User      @relation(fields: [uploaderId], references: [id])
  messageId  String?
  message    Message?  @relation(fields: [messageId], references: [id], onDelete: SetNull)
  // Display name only. The place on disk is storageKey, generated by the server.
  name       String
  // image/png|jpeg|gif|webp when the content really is one of those, otherwise application/octet-stream.
  mime       String
  size       Int
  sha256     String
  storageKey String    @unique
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?

  @@index([messageId])
  @@index([chatId])
  @@index([uploaderId])
}

// One browser/device that agreed to receive push notifications.
model PushSubscription {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Address of the browser vendor's push service; validated against an allow-list before it is stored or used.
  endpoint      String    @unique
  p256dh        String
  auth          String
  userAgent     String?
  failures      Int       @default(0)
  createdAt     DateTime  @default(now())
  lastSuccessAt DateTime?

  @@index([userId])
}
